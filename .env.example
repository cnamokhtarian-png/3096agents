# =========================================================================
# Freelance & Crypto Agent OS — نمونه‌ی متغیرهای محیطی (هیچ کلید واقعی اینجا نگذارید)
# روی Vercel: Project → Settings → Environment Variables
# =========================================================================

# ── دیتابیس (Supabase) ───────────────────────────────────────────────────
# Pooler (transaction mode, port 6543) — برای Vercel serverless
DATABASE_URL=postgres://agentos.PROJECT_REF:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
# Session mode (port 5432) — برای drizzle-kit / migration
DIRECT_URL=postgres://agentos.PROJECT_REF:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
# اختیاری — اگر بعداً supabase-js اضافه کردید
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── احراز هویت مدیرعامل ──────────────────────────────────────────────────
ADMIN_EMAIL=ceo@company.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# python3 -c "import secrets;print(secrets.token_hex(32))"
AUTH_SECRET=CHANGE_ME_64_HEX
# اختیاری: دسترسی ماشین‌به‌ماشین به APIهای مدیریتی با هدر x-admin-secret
ADMIN_API_SECRET=

# ── کیف پول واحد USDT ────────────────────────────────────────────────────
MASTER_WALLET_ADDRESS=
MASTER_WALLET_NETWORK=TRC20

# ── تلگرام (Human-in-the-Loop) ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# دامنه‌ی عمومی برای ساخت آدرس وبهوک و لینک گزارش‌ها
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# اختیاری — برای پروکسی یا تست محلی Bot API
TELEGRAM_API_BASE=

# ── صرافی (آریا / تریدر) ─────────────────────────────────────────────────
EXCHANGE_API_KEY=
# نام قدیمی/جایگزین همین کلید: EXCHANGE_API_SECRET (هر دو پشتیبانی می‌شوند)
EXCHANGE_SECRET_KEY=
# true → سفارش‌ها به testnet.binance.vision می‌روند
EXCHANGE_TESTNET=true
# قفل ایمنی: بدون true هیچ سفارش واقعی ارسال نمی‌شود
AGENT_TRADING_ENABLED=false
# اختیاری — برای Testnet سفارشی، پروکسی یا تست خودکار
EXCHANGE_BASE_URL=

# ── تأیید زنجیره‌ای واریزها (اختیاری اما توصیه‌شده) ─────────────────────
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=

# ── هوش مصنوعی و ورکر ابزارها ────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AGENT_WORKER_URL=
AGENT_WORKER_TOKEN=

# ── کرون و کلید ماشین‌ها ─────────────────────────────────────────────────
# Vercel Cron این مقدار را به‌صورت Bearer می‌فرستد
CRON_SECRET=CHANGE_ME_RANDOM
# برای گرفتن درآمد با x-agent-key از ربات‌های بیرونی (اختیاری)
AGENT_MASTER_API_KEY=
# کلید اختصاصی هر کارمند هنگام seed (اختیاری، وگرنه تصادفی امن ساخته می‌شود)
AGENT_KEY_CRYPTO_EMPLOYEE=
AGENT_KEY_NEXTJS_BUILDER=
AGENT_KEY_TELEGRAM_CLOSER=
AGENT_KEY_PPTX_DESIGNER=
AGENT_KEY_WEB3_TRANSLATOR=
AGENT_KEY_CUSTOM_WEBHOOK_WORKER=
