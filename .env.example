# Copy to .env and fill in. NEVER commit .env to git.
# Pooler (transaction mode, port 6543) - use for Vercel serverless
DATABASE_URL=postgres://agentos.rvryatkhtakavinbpueh:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Session mode (port 5432) - for migrations / drizzle-kit
DIRECT_URL=postgres://agentos.rvryatkhtakavinbpueh:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

ADMIN_EMAIL=admin@freelance.ir
ADMIN_PASSWORD=admin123
# Random 64-hex secret for session signing. Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
AUTH_SECRET=change-me-to-random-hex

MASTER_WALLET_ADDRESS=
MASTER_WALLET_NETWORK=TRC20

# Optional - Telegram bot (app works without it, messages get simulated)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=
