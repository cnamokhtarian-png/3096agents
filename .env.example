# Copy to .env and fill in. NEVER commit .env to git.
# Pooler (transaction mode, port 6543) - use for Vercel serverless
DATABASE_URL=postgres://agentos.rvryatkhtakavinbpueh:YOUR_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
# Session mode (port 5432) - for migrations / drizzle-kit
DIRECT_URL=postgres://agentos.rvryatkhtakavinbpueh:YOUR_PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

ADMIN_EMAIL=admin@freelance.ir
ADMIN_PASSWORD=admin123
# Random 64-hex secret for session signing. Generate: python3 -c "import secrets;print(secrets.token_hex(32))"
AUTH_SECRET=change-me-to-random-hex

MASTER_WALLET_ADDRESS=
MASTER_WALLET_NETWORK=TRC20

# Optional - Telegram bot (app works without it, messages get simulated)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=

# Vercel Cron (اول هر ماه): Vercel بهصورت خودکار آن را میسازد/میفرستد.
# برای تست دستی: curl -H "Authorization: Bearer $CRON_SECRET" .../api/leaderboard/cron
CRON_SECRET=

# اختیاری: کلید سراسری ایجنتها برای ثبت نتیجه/واریز از سرویسهای بیرونی
AGENT_MASTER_API_KEY=

# ── 🪙 میز کار ایجنت تریدر (A1 - آریا) ──────────────────────────────────
# آدرس پابلیک اپ (برای لینک «میز کار آریا» در پیامهای تلگرام)
NEXT_PUBLIC_APP_URL=
# پایهٔ اختیاری API صرافی (پیشفرض: api.binance.com سپس api.binance.us)
MARKET_API_BASE=
# قیمت جایگزین وقتی هیچ منبعی در دسترس نیست (فقط حالت fallback)
MARKET_FALLBACK_PRICE=75800
# کلید اختیاری اخبار/احساسات (بدون آن sentiment خنثی و برچسب میخورد)
CRYPTOPANIC_API_KEY=

# ⚠️ اجرای واقعی معاملات اهرمدار: فقط در صورت تمایل صریح ست کنید.
# بدون این کلیدها حالت trader_mode=live هم به Paper امن برمیگردد.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_FUTURES_BASE=https://fapi.binance.com
